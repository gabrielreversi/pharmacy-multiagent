OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<deployment-chat>
AZURE_OPENAI_API_VERSION=2024-10-21

AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=<gerar com: openssl rand -hex 24>
QDRANT_COLLECTION=drug_leaflets_te3s

RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0

AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<conta>;AccountKey=<chave>;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER=bulas-dev

POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=<gerar com: openssl rand -hex 16>
POSTGRES_DB=pharmacy
DATABASE_URL=postgresql+psycopg://pharmacy:<senha>@localhost:5432/pharmacy

REDIS_URL=redis://localhost:6379/0

INGESTION_STREAM=ingestion:documents
INGESTION_DEAD_STREAM=ingestion:dead
INGESTION_GROUP=ingestion-workers
INGESTION_MAX_ATTEMPTS=3
INGESTION_CLAIM_IDLE_MS=60000

UPLOAD_MAX_FILE_MB=20
UPLOAD_MAX_FILES=10

CHUNK_HEADER="#####"
CHUNK_MAX_CHARS=4000
CHUNK_OVERLAP_CHARS=400
CHUNK_MIN_CHARS=200
EMBEDDING_BATCH_SIZE=64
